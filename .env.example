# Copy to .env and fill in real values. See docs/environment.md for details.

# Shared
# For local dev with postgres on host port 5433:
POSTGRES_DSN=postgres://appgent:appgent@localhost:5433/appgent?sslmode=disable
# For docker-compose (container networking):
# POSTGRES_DSN=postgres://appgent:appgent@postgres:5432/appgent?sslmode=disable
TEMPORAL_HOST_PORT=temporal:7233
TEMPORAL_NAMESPACE=default
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=appgent-runs
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
LOG_LEVEL=info

# API server
API_PORT=8080
JWT_SIGNING_SECRET=change-me-in-prod
SESSION_COOKIE_NAME=session
SESSION_TTL_HOURS=168
CORS_ALLOWED_ORIGIN=http://localhost:23000
ADMIN_SEED_EMAIL=admin
ADMIN_SEED_PASSWORD=admin

# AI Provider (openrouter, openai, anthropic, ollama)
AI_PROVIDER=openrouter
AI_API_KEY=sk-or-replace-me
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-ultra:free

# Per-agent model overrides (optional)
AI_MODEL_PLAN=nvidia/nemotron-3-ultra:free
AI_MODEL_DESIGN=nvidia/nemotron-3-ultra:free
AI_MODEL_CODE=nvidia/nemotron-3-ultra:free
AI_MODEL_QA=nvidia/nemotron-3-ultra:free
AI_MODEL_EMBEDDING=nvidia/nemotron-3-ultra:free

# OpenRouter (used when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Ollama (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Worker
MAX_QA_RETRIES=3
WORKER_MAX_CONCURRENT_ACTIVITIES=10

# Next.js
NEXT_PUBLIC_API_BASE_URL=http://localhost:28080/api/v1