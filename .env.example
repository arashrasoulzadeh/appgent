# Copy to .env and fill in real values. See docs/environment.md for details.

# Shared
# For docker-compose (container networking) — the default, works for api/worker/migrate/seed:
POSTGRES_DSN=postgres://appgent:appgent@postgres:5432/appgent?sslmode=disable
# For running api/worker natively on the host (go run ./services/...), postgres
# has no host port by default — add one temporarily (e.g. "15432:5432" under
# postgres.ports in docker-compose.yml) and point this at localhost:<that port> instead.
TEMPORAL_HOST_PORT=temporal:7233
TEMPORAL_NAMESPACE=default
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=appgent-runs
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
LOG_LEVEL=info

# API server
API_PORT=8080
JWT_SIGNING_SECRET=change-me-in-prod
SESSION_COOKIE_NAME=session
SESSION_TTL_HOURS=168
CORS_ALLOWED_ORIGIN=http://localhost:23000
ADMIN_SEED_EMAIL=admin@admin.com
ADMIN_SEED_PASSWORD=admin!@#$

# AI Provider (openrouter, openai, anthropic, ollama, gapgpt)
AI_PROVIDER=openrouter

# AI_API_KEY / AI_BASE_URL / AI_MODEL below are LAST-RESORT fallbacks, only
# used if the provider-specific vars in the sections below (OPENROUTER_*,
# OLLAMA_*, GAPGPT_*, etc. matching whatever AI_PROVIDER is set to) are
# unset. If you switch AI_PROVIDER, prefer setting that provider's own
# _MODEL/_API_KEY/_BASE_URL vars rather than these — leaving a stale
# AI_MODEL here from a previous provider will NOT override the new
# provider's own model var, but it WILL silently apply if that var is
# ever left blank, so keep this section empty/unset once you've picked a
# provider and set its dedicated vars.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional per-agent model overrides — HIGHEST priority, above even the
# provider-specific _MODEL var above, for whichever agent's var is set.
# Leave unset (the normal case) to just use the provider's own model for
# every agent. AI_MODEL_EMBEDDING is read for embeddings regardless of
# AI_PROVIDER; AI_MODEL_PLAN/_DESIGN/_CODE/_QA each override that one
# agent's model specifically. A leftover value here from a previous
# AI_PROVIDER WILL silently override the new provider's model — clear
# these when you switch providers unless you actually want a per-agent
# override.
# AI_MODEL_PLAN=
# AI_MODEL_DESIGN=
# AI_MODEL_CODE=
# AI_MODEL_QA=
AI_MODEL_EMBEDDING=nvidia/nemotron-3-ultra-550b-a55b:free

# OpenRouter (used when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Ollama (used when AI_PROVIDER=ollama)
# If the worker runs in docker compose and Ollama runs on the HOST (not in
# compose), use http://host.docker.internal:11434 instead of localhost —
# "localhost" inside the worker container refers to the container itself.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# GapGPT (used when AI_PROVIDER=gapgpt) — OpenAI-API-compatible proxy
GAPGPT_API_KEY=sk-...
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gpt-4o-mini

# Worker
MAX_QA_RETRIES=3
WORKER_MAX_CONCURRENT_ACTIVITIES=10

# Code generation concurrency: true = fan pages/components/shared files out
# as concurrent CodeActivity calls (fast); false = generate them strictly
# one at a time (slower, but lighter load per call — useful for small local
# models via Ollama, or to stay under a provider's rate limits).
CODE_GEN_PARALLEL=true

# Next.js
NEXT_PUBLIC_API_BASE_URL=http://localhost:28080/api/v1

# Temporal UI basic auth (fronted by infra/temporal-ui-proxy)
TEMPORAL_UI_USER=admin
TEMPORAL_UI_PASSWORD=change-me-in-prod